{
  "name": "songbot-desktop",
  "version": "2.0.0",
  "private": true,
  "description": "bili-songbot 直播间点歌台的桌面外壳（Electron + TypeScript）",
  "author": "bili-songbot",
  "license": "GPL-3.0",
  "main": "desktop/main.js",
  "scripts": {
    "server:install": "npm --prefix server install",
    "server:build": "npm --prefix server run build",
    "server:start": "npm --prefix server run start",
    "prestart": "npm run server:build",
    "start": "electron .",
    "runtime:win": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build_windows_runtime.ps1",
    "dist": "npm run server:build && npm run runtime:win && electron-builder --win zip",
    "dist:dir": "npm run server:build && electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.songbot.desktop",
    "productName": "SongBot",
    "directories": {
      "output": "release",
      "buildResources": "desktop/build"
    },
    "files": [
      "desktop/**/*",
      "design/**/*",
      "server/dist/**/*",
      "server/node_modules/**/*",
      "server/package.json",
      "config.example.json",
      "LICENSE"
    ],
    "asar": true,
    "asarUnpack": [
      "server/**/*",
      "config.example.json"
    ],
    "extraResources": [
      {
        "from": "build-runtime/ffmpeg",
        "to": "runtime/ffmpeg"
      }
    ],
    "artifactName": "SongBot-${version}-win-x64.zip",
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "electronLanguages": [
        "zh-CN"
      ],
      "icon": "desktop/build/icon.ico"
    }
  }
}
