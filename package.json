{
  "name": "songbot-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "bili-songbot 直播间点歌台的桌面外壳（Electron）",
  "author": "bili-songbot",
  "license": "GPL-3.0",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:dir": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.songbot.desktop",
    "productName": "SongBot",
    "directories": {
      "output": "release",
      "buildResources": "desktop/build"
    },
    "files": [
      "desktop/**/*",
      "design/**/*",
      "main.py",
      "bot/**/*",
      "source_bridge.js",
      "musicSdk_bundle.cjs",
      "sources/**/*",
      "config.example.json",
      "requirements.txt"
    ],
    "asar": true,
    "asarUnpack": [
      "main.py",
      "bot/**/*",
      "source_bridge.js",
      "musicSdk_bundle.cjs",
      "sources/**/*",
      "config.example.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SongBot 点歌台"
    }
  }
}
