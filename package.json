{
  "name": "songbot-desktop",
  "version": "1.0.1",
  "private": true,
  "description": "bili-songbot 直播间点歌台的桌面外壳（Electron）",
  "author": "bili-songbot",
  "license": "GPL-3.0",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "runtime:win": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build_windows_runtime.ps1",
    "dist": "npm run runtime:win && electron-builder --win zip",
    "dist:dir": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.songbot.desktop",
    "productName": "SongBot",
    "directories": {
      "output": "release",
      "buildResources": "desktop/build"
    },
    "files": [
      "desktop/**/*",
      "design/**/*",
      "main.py",
      "bot/**/*",
      "source_bridge.js",
      "musicSdk_bundle.cjs",
      "sources/**/*",
      "config.example.json",
      "requirements.txt"
    ],
    "asar": true,
    "asarUnpack": [
      "main.py",
      "bot/**/*",
      "source_bridge.js",
      "musicSdk_bundle.cjs",
      "sources/**/*",
      "config.example.json"
    ],
    "extraResources": [
      {
        "from": "build-runtime/python",
        "to": "runtime/python"
      },
      {
        "from": "build-runtime/node",
        "to": "runtime/node"
      },
      {
        "from": "build-runtime/ffmpeg",
        "to": "runtime/ffmpeg"
      }
    ],
    "artifactName": "SongBot-${version}-win-x64.zip",
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "electronLanguages": [
        "zh-CN"
      ],
      "icon": "desktop/build/icon.ico"
    }
  }
}
